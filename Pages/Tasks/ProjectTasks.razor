@page "/projects/{ProjectId:int}/tasks"
@using UserApi.Blazor.Models.Requests
@using UserApi.Blazor.Models.Responses
@using UserApi.Blazor.Models.Enums
@using UserApi.Blazor.Services
@inject TaskItemService TaskItemService
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<RequireAuth>
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <button class="btn btn-outline-secondary btn-sm mb-3" @onclick="BackToProjects">← Back to
                    Projects</button>
                    <h2 class="mb-1">Project Tasks</h2>
                    @if (!string.IsNullOrWhiteSpace(projectName))
                    {
                        <p class="text-muted mb-0">
                            Project: <strong>@projectName</strong>
                        </p>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            Manage tasks inside this project.
                        </p>
                    }
                </div>
                @if (AuthService.CurrentUser is not null)
                {
                    <span class="badge bg-primary">
                        @AuthService.CurrentUser.Role
                    </span>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger">
                    @errorMessage
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="alert alert-success">
                    @successMessage
                </div>
            }
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title mb-3">Create Task</h5>

                            <EditForm Model="createTaskRequest" OnValidSubmit="CreateTask">
                                <DataAnnotationsValidator />

                                <div class="mb-3">
                                    <label class="form-label">Title</label>
                                    <InputText class="form-control" @bind-Value="createTaskRequest.Title"
                                               placeholder="Example: Build login UI" />
                                    <ValidationMessage For="@(() => createTaskRequest.Title)" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Description</label>
                                    <InputTextArea class="form-control" rows="4" @bind-Value="createTaskRequest.Description"
                                                   placeholder="Short description..." />
                                    <ValidationMessage For="@(() => createTaskRequest.Description)" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Due date</label>
                                    <InputDate class="form-control" @bind-Value="createTaskRequest.DueDate" />
                                </div>

                                <button type="submit" class="btn btn-primary w-100" disabled="@isCreating">
                                    @(isCreating ? "Creating..." : "Create Task")
                                </button>
                            </EditForm>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8">
                    @if (isLoading)
                    {
                        <div class="alert alert-info">
                            Loading tasks...
                        </div>
                    }
                    else if (tasks.Count == 0)
                    {
                        <div class="card shadow-sm">
                            <div class="card-body text-center py-5">
                                <h5>No tasks yet</h5>
                                <p class="text-muted mb-0">
                                    Create the first task for this project.
                                </p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var task in tasks)
                            {
                                <div class="col-md-6">
                                    <div class="card h-100 shadow-sm">
                                        <div class="card-body d-flex flex-column">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <h5 class="card-title mb-0">
                                                    @task.Title
                                                </h5>

                                                <span class="@GetStatusBadgeClass(task.Status)">
                                                    @task.Status
                                                </span>
                                            </div>

                                            <p class="text-muted flex-grow-1">
                                                @(string.IsNullOrWhiteSpace(task.Description)
                                                    ? "No description"
                                                    : task.Description)
                                            </p>

                                            <div class="small text-muted mb-2">
                                                Project: @task.ProjectName
                                            </div>

                                            <div class="small text-muted mb-3">
                                                Due date:
                                                @(task.DueDate.HasValue
                                                    ? task.DueDate.Value.ToString("yyyy-MM-dd")
                                                    : "No due date")
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label small">Status</label>
                                                <select class="form-select form-select-sm" value="@((int)task.Status)"
                                                        @onchange="e => ChangeStatus(task, e)">
                                                    <option value="1">Todo</option>
                                                    <option value="2">InProgress</option>
                                                    <option value="3">Done</option>
                                                </select>
                                            </div>
                                            <div class="d-flex gap-2 mt-auto">
                                                <button class="btn btn-outline-primary btn-sm"
                                                        @onclick="() => ViewTaskDetail(task.Id)">
                                                    View
                                                </button>
                                                <button class="btn btn-outline-warning btn-sm"
                                                        @onclick="() => OpenEditTaskModal(task.Id)">
                                                    Edit
                                                </button>
                                                <button class="btn btn-outline-danger btn-sm mt-auto"
                                                        @onclick="() => DeleteTask(task.Id)">
                                                    Delete
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

        </div>
    </RequireAuth>

    @if (showTaskDetailModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content shadow">
                    <div class="modal-header">
                        <h5 class="modal-title">Task Detail</h5>

                        <button type="button" class="btn-close" @onclick="CloseTaskDetailModal">
                        </button>
                    </div>

                    <div class="modal-body">
                        @if (isLoadingTaskDetail)
                        {
                            <div class="text-center py-4">
                                <div class="spinner-border text-primary mb-3" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>

                                <p class="text-muted mb-0">
                                    Loading task detail...
                                </p>
                            </div>
                        }
                        else if (selectedTask is not null)
                        {
                            <div class="mb-3">
                                <div class="text-muted small">Task Id</div>
                                <div class="fw-semibold">#@selectedTask.Id</div>
                            </div>

                            <div class="mb-3">
                                <div class="text-muted small">Title</div>
                                <div class="fw-semibold">@selectedTask.Title</div>
                            </div>

                            <div class="mb-3">
                                <div class="text-muted small">Description</div>
                                <div>
                                    @(string.IsNullOrWhiteSpace(selectedTask.Description)
                                        ? "No description"
                                        : selectedTask.Description)
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="text-muted small">Status</div>
                                <span class="@GetStatusBadgeClass(selectedTask.Status)">
                                    @selectedTask.Status
                                </span>
                            </div>

                            <div class="mb-3">
                                <div class="text-muted small">Due Date</div>
                                <div>
                                    @(selectedTask.DueDate.HasValue
                                        ? selectedTask.DueDate.Value.ToString("yyyy-MM-dd")
                                        : "No due date")
                                </div>
                            </div>

                            <hr />

                            <div class="mb-3">
                                <div class="text-muted small">Project</div>
                                <div>@selectedTask.ProjectName</div>
                            </div>

                            <div class="mb-3">
                                <div class="text-muted small">Project Id</div>
                                <div>#@selectedTask.ProjectId</div>
                            </div>

                            <div class="mb-3">
                                <div class="text-muted small">Owner</div>
                                <div>@selectedTask.OwnerName</div>
                            </div>

                            <div>
                                <div class="text-muted small">Owner Id</div>
                                <div>#@selectedTask.OwnerId</div>
                            </div>
                        }
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CloseTaskDetailModal">
                            Close
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }


    @if (showEditTaskModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content shadow">
                    <div class="modal-header">
                        <h5 class="modal-title">Edit Task</h5>

                        <button type="button" class="btn-close" @onclick="CloseEditTaskModal">
                        </button>
                    </div>

                    <div class="modal-body">
                        @if (isLoadingEditTask)
                        {
                            <div class="text-center py-4">
                                <div class="spinner-border text-primary mb-3" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>

                                <p class="text-muted mb-0">
                                    Loading task information...
                                </p>
                            </div>
                        }
                        else
                        {
                            @if (!string.IsNullOrWhiteSpace(editTaskErrorMessage))
                            {
                                <div class="alert alert-danger">
                                    @editTaskErrorMessage
                                </div>
                            }

                            <EditForm Model="updateTaskRequest" OnValidSubmit="UpdateTask">
                                <DataAnnotationsValidator />

                                <div class="mb-3">
                                    <label class="form-label">Title</label>
                                    <InputText class="form-control" @bind-Value="updateTaskRequest.Title" />
                                    <ValidationMessage For="@(() => updateTaskRequest.Title)" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Description</label>
                                    <InputTextArea class="form-control" rows="4" @bind-Value="updateTaskRequest.Description" />
                                    <ValidationMessage For="@(() => updateTaskRequest.Description)" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Status</label>
                                    <InputSelect class="form-select" @bind-Value="updateTaskRequest.Status">
                                        <option value="@TaskItemStatus.Todo">Todo</option>
                                        <option value="@TaskItemStatus.InProgress">InProgress</option>
                                        <option value="@TaskItemStatus.Done">Done</option>
                                    </InputSelect>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Due Date</label>
                                    <InputDate class="form-control" @bind-Value="updateTaskRequest.DueDate" />
                                </div>

                                <div class="alert alert-info small">
                                    This form updates the full task information. You can still use the quick status dropdown on the
                                    task card.
                                </div>

                                <div class="d-flex justify-content-end gap-2">
                                    <button type="button" class="btn btn-secondary" @onclick="CloseEditTaskModal">
                                        Cancel
                                    </button>

                                    <button type="submit" class="btn btn-primary" disabled="@isUpdatingTask">
                                        @(isUpdatingTask ? "Saving..." : "Save Changes")
                                    </button>
                                </div>
                            </EditForm>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

@code {
    [Parameter]
    public int ProjectId { get; set; }

    private List<TaskItemResponse> tasks = new();
    private CreateTaskItemRequest createTaskRequest = new();

    private bool isLoading;
    private bool isCreating;

    private string? errorMessage;
    private string? successMessage;
    private string? projectName;

    private int? loadedProjectId;

    @* get task detail *@
    private TaskItemResponse? selectedTask;
    private bool showTaskDetailModal;
    private bool isLoadingTaskDetail;

    @* update full task info *@
    private int editingTaskId;

    private UpdateTaskItemRequest updateTaskRequest = new();

    private bool showEditTaskModal;

    private bool isLoadingEditTask;

    private bool isUpdatingTask;

    private string? editTaskErrorMessage;

    @* protected override async Task OnParametersSetAsync()
    {
        if (!AuthService.IsInitialized)
        {
            return;
        }

        if (!AuthService.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        if (loadedProjectId == ProjectId)
        {
            return;
        }

        loadedProjectId = ProjectId;
        await LoadTasks();
    } *@

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!AuthService.IsInitialized ||
            !AuthService.IsAuthenticated)
        {
            return;
        }

        if (loadedProjectId == ProjectId)
        {
            return;
        }

        loadedProjectId = ProjectId;

        await LoadTasks();

        StateHasChanged();
    }

    private async Task LoadTasks()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var result = await TaskItemService.GetTasksAsync(ProjectId);
            if (result?.Content is not null)
            {
                tasks = result.Content;
                projectName = tasks.FirstOrDefault()?.ProjectName;
            }
            else
            {
                errorMessage = result?.Message ?? "Cannot load tasks.";
            }
        }
        catch
        {
            errorMessage = "Cannot connect to API";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateTask()
    {
        isCreating = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var result = await TaskItemService.CreateTaskAsync(
                ProjectId,
                createTaskRequest);

            if (result?.Content is not null)
            {
                successMessage = result.Message;
                createTaskRequest = new CreateTaskItemRequest();

                await LoadTasks();
            }
            else
            {
                errorMessage = result?.Message ?? "Cannot create task.";
            }
        }
        catch
        {
            errorMessage = "Cannot connect to API.";
        }
        finally
        {
            isCreating = false;
        }
    }

    private async Task ChangeStatus(TaskItemResponse task, ChangeEventArgs e)
    {
        errorMessage = null;
        successMessage = null;

        if (!int.TryParse(e.Value?.ToString(), out var statusValue))
        {
            errorMessage = "Invalid status.";
            return;
        }

        var newStatus = (TaskItemStatus)statusValue;

        var request = new UpdateTaskItemRequest
        {
            Title = task.Title,
            Description = task.Description,
            DueDate = task.DueDate,
            Status = newStatus
        };

        try
        {
            var result = await TaskItemService.UpdateTaskAsync(
                ProjectId,
                task.Id,
                request);

            if (result?.Content is not null)
            {
                successMessage = result.Message;
                await LoadTasks();
            }
            else
            {
                errorMessage = result?.Message ?? "Cannot update task.";
            }
        }
        catch
        {
            errorMessage = "Cannot connect to API.";
        }
    }

    private async Task DeleteTask(int taskId)
    {
        errorMessage = null;
        successMessage = null;

        try
        {
            var result = await TaskItemService.DeleteTaskAsync(
                ProjectId,
                taskId);

            if (result?.Content == true)
            {
                successMessage = result.Message;
                await LoadTasks();
            }
            else
            {
                errorMessage = result?.Message ?? "Cannot delete task.";
            }
        }
        catch
        {
            errorMessage = "Cannot connect to API.";
        }
    }

    private void BackToProjects()
    {
        NavigationManager.NavigateTo("/projects");
    }

    private static string GetStatusBadgeClass(TaskItemStatus status)
    {
        return status switch
        {
            TaskItemStatus.Todo => "badge bg-secondary",
            TaskItemStatus.InProgress => "badge bg-warning text-dark",
            TaskItemStatus.Done => "badge bg-success",
            _ => "badge bg-secondary"
        };
    }

    @* get task detail *@
    private async Task ViewTaskDetail(int taskId)
    {
        errorMessage = null;
        successMessage = null;

        selectedTask = null;
        showTaskDetailModal = true;
        isLoadingTaskDetail = true;

        try
        {
            var result = await TaskItemService.GetTaskByIdAsync(ProjectId, taskId);

            if (result?.Content is not null)
            {
                selectedTask = result.Content;
            }
            else
            {
                errorMessage = result?.Message ?? "Cannot load task detail.";
                showTaskDetailModal = false;
            }
        }
        catch
        {
            errorMessage = "Cannot connect to API.";
            showTaskDetailModal = false;
        }
        finally
        {
            isLoadingTaskDetail = false;
        }
    }

    private void CloseTaskDetailModal()
    {
        showTaskDetailModal = false;
        selectedTask = null;
    }

    private async Task OpenEditTaskModal(int taskId)
    {
        errorMessage = null;
        successMessage = null;
        editTaskErrorMessage = null;

        editingTaskId = taskId;
        updateTaskRequest = new UpdateTaskItemRequest();

        showEditTaskModal = true;
        isLoadingEditTask = true;

        try
        {
            var result = await TaskItemService.GetTaskByIdAsync(
                ProjectId,
                taskId);

            if (result?.Content is not null)
            {
                updateTaskRequest = new UpdateTaskItemRequest
                {
                    Title = result.Content.Title,
                    Description = result.Content.Description,
                    Status = result.Content.Status,
                    DueDate = result.Content.DueDate
                };
            }
            else
            {
                editTaskErrorMessage = result?.Message ?? "Cannot load task information.";
            }
        }
        catch
        {
            editTaskErrorMessage = "Cannot connect to API.";
        }
        finally
        {
            isLoadingEditTask = false;
        }
    }

    private void CloseEditTaskModal()
    {
        showEditTaskModal = false;
        editingTaskId = 0;
        updateTaskRequest = new UpdateTaskItemRequest();
        isLoadingEditTask = false;
        isUpdatingTask = false;
        editTaskErrorMessage = null;
    }

    private async Task UpdateTask()
    {
        if (editingTaskId <= 0)
        {
            editTaskErrorMessage = "Invalid task.";
            return;
        }

        editTaskErrorMessage = null;
        errorMessage = null;
        successMessage = null;
        isUpdatingTask = true;

        try
        {
            var result = await TaskItemService.UpdateTaskAsync(ProjectId, editingTaskId, updateTaskRequest);

            if (result?.Content is not null)
            {
                successMessage = result.Message;

                CloseEditTaskModal();

                await LoadTasks();
            }
            else
            {
                editTaskErrorMessage = result?.Message ?? "Cannot update task.";
            }
        }
        catch
        {
            editTaskErrorMessage = "Cannot connect to API.";
        }
        finally
        {
            isUpdatingTask = false;
        }
    }
}