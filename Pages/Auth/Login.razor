@page "/login"
@using UserApi.Blazor.Models.Requests
@using UserApi.Blazor.Services
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h3 class="mb-3">Login</h3>

                @if (string.IsNullOrWhiteSpace(errorMessage) == false)
                {
                    <div class="alert alert-danger">
                        @errorMessage
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input class="form-control" @bind="loginRequest.Email" placeholder="Enter email" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input class="form-control" @bind="loginRequest.Password" placeholder="Enter passowrd" />
                </div>

                <button class="btn btn-primary w-100" @onclick="HandleLogin" disabled="@isLoading">
                    @(isLoading ? "Logging in..." : "Login")
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginRequest loginRequest = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading;
    private async Task HandleLogin()
    {
        errorMessage = null;
        successMessage = null;
        isLoading = true;

        try
        {
            var result = await AuthService.LoginAsync(loginRequest);
            if (result?.Content is not null)
            {
                successMessage = result.Message;
                NavigationManager.NavigateTo("/projects");
            }
            else
            {
                errorMessage = result?.Message ?? "Login failed.";
            }
        }
        catch
        {
            errorMessage = "Cannot connect to API.";
        }
        finally
        {
            isLoading = false;
        }
    }
}