@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="alert alert-danger d-flex align-items-start" role="alert">
        <div class="me-2">
            ⚠️
        </div>

        <div>
            <strong>Error</strong>
            <div>@Message</div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string? Message { get; set; }
}